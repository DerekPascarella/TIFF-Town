<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TiffTown.App.App"
             Name="TIFF Town"
             RequestedThemeVariant="Light">

    <!-- Override Avalonia's hardcoded "About Avalonia" entry in the macOS app menu.
         Defining a NativeMenu here suppresses CreateDefaultAppMenu(). The standard
         Services/Hide/Quit items are still appended automatically. -->
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="About TIFF Town" Click="AboutMenuItem_Click"/>
        </NativeMenu>
    </NativeMenu.Menu>

    <Application.Resources>
        <!-- Brand green. Light/Dark variants are HSL L +/- 10/20/30 from base. -->
        <Color x:Key="SystemAccentColor">#33CC66</Color>
        <Color x:Key="SystemAccentColorLight1">#5CD685</Color>
        <Color x:Key="SystemAccentColorLight2">#85E0A3</Color>
        <Color x:Key="SystemAccentColorLight3">#ADEBC2</Color>
        <Color x:Key="SystemAccentColorDark1">#29A352</Color>
        <Color x:Key="SystemAccentColorDark2">#1F7A3D</Color>
        <Color x:Key="SystemAccentColorDark3">#145229</Color>

        <Color x:Key="TextControlSelectionHighlightColor">#CCCCCC</Color>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml"/>

        <Style Selector="Button">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- Option captions: the small explanation line under each control. -->
        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#777777"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,8"/>
        </Style>

        <Style Selector="TextBlock.section">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
    </Application.Styles>

</Application>
